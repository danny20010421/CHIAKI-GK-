# ═══════════════════════════════════════════════════════════════════════
# CHIAKI 平台環境變數範本
#   本機開發：cp .env.example .env（預設值即可在本機執行，含開發替身）
#   正式部署：在主機/平台的「環境變數」介面逐項設定；標 ★ 的項目正式環境必須修改。
#   ⚠ 真正的密碼、金鑰只放在 .env（已被 .gitignore 排除）或平台的 secret 設定，切勿提交版控。
#   完整步驟見 docs/DEPLOY.md。
# ═══════════════════════════════════════════════════════════════════════

# ── 執行環境 ─────────────────────────────────────────────
# NODE_ENV=production      # ★ 正式環境（Docker 映像已預設 production）；production 會拒絕開發替身並檢查必要設定
# PORT=3000                # 網站監聽埠（平台通常自動注入）
# APP_VERSION=             # 選用：顯示於 /api/health 的版本字串（例如 git commit）
LOG_LEVEL=info             # 日誌等級 debug / info / warn / error（JSON 一行一筆）

# ── 資料庫（PostgreSQL 16+）───────────────────────────────
# 本機：npm run db:local 會啟動 PostgreSQL 於 55432 埠
# ★ 正式：postgres://使用者:密碼@主機:5432/資料庫?sslmode=require（Zeabur/Render 的 Postgres 會提供連線字串）
DATABASE_URL=postgres://postgres@127.0.0.1:55432/chiaki
DATABASE_POOL_MAX=20       # 每個程序的連線數上限（小方案資料庫建議 10）
DEFAULT_MERCHANT_ID=chiaki

# docker-compose.yml 專用（只在用 compose 跑 PostgreSQL 時需要）
# POSTGRES_PASSWORD=       # ★ compose 內建資料庫密碼
# APP_PORT=3000            # compose 對外的網站埠

# ── 網址與網域 ───────────────────────────────────────────
# ★ 前台網站網址（綠界付款回傳網址、CSRF/CORS 允許的 origin），正式必須為 https://
APP_BASE_URL=http://localhost:3000
# 後台獨立網域：設定後 /api/admin/* 與 /api/auth/admin/* 只在此主機名稱提供，其他主機一律 404
ADMIN_HOST=                # 例如 admin.chiaki.tw（只填主機名稱，不含 https://）
ADMIN_BASE_URL=            # 後台介面網址，例如 https://admin.chiaki.tw（空白＝https://<ADMIN_HOST>）
HOST_HEADER=host           # 判斷主機名稱用的 header；反向代理改寫 Host 時改為 x-forwarded-host
CORS_ALLOWED_ORIGINS=      # 另外允許跨網域呼叫公開 API 的前台（逗號分隔），例如 https://chiaki.tw,https://www.chiaki.tw
CLIENT_IP_HEADER=x-forwarded-for  # 反向代理寫入的用戶端 IP header（Cloudflare 可用 cf-connecting-ip）

# ── 圖片／影片（CDN、物件儲存）──────────────────────────
# 資料庫只存站內路徑（例如 /media/video/gacha1.mp4、/media/banners/halloween.jpg）；
# 設定後輸出網址會變成 MEDIA_BASE_URL + 路徑（賞池封面、獎項圖、橫幅、IP 封面、抽賞影片）。
# 空白＝由本站提供（檔案需在建置前放入 public/media/）。後台上傳的圖片（/api/assets/:id）存在資料庫，不受影響。
MEDIA_BASE_URL=            # 例如 https://cdn.chiaki.tw 或 https://<bucket>.r2.dev（結尾不要加 /）
ASSET_UPLOAD_MAX_BODY_BYTES=2200000 # 後台圖片素材上傳（base64 JSON）本文上限；最大檔 1500 KB
# 預留（程式目前不讀取）：媒體檔請用 R2 / S3 / Bunny 的主控台或 CLI 上傳到與路徑相同的位置
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# ── 測試模式（金流／簡訊開關）─────────────────────────────
# true（預設）：測試網站，所有金流端點回 403「此為測試網站，不進行商業行為」；未設定簡訊時 OTP 回 503 SMS_DISABLED。
# ★ 公司成立、綠界與簡訊都設定好之後才改為 false；production 若設 false 但仍是綠界測試商店或缺簡訊帳號，會拒絕啟動。
SITE_TEST_MODE=true
PAYMENT_SANDBOX=           # 測試網站上仍要走綠界 STAGE 沙盒時設 1（只在 SITE_TEST_MODE=true 時有意義）

# ── 綠界 ECPay（公司成立後填入）───────────────────────────
# 未設定時使用綠界官方公開 STAGE 測試商店（3002607，已與官方 SDK 範例比對），只能測試、不會真的收款。
# ★ 正式：公司成立並與綠界簽約後，取消註解並填入正式商店代號/金鑰（放在 secret 設定）。
# ECPAY_MERCHANT_ID=       # 公司成立後填入：特店編號
# ECPAY_HASH_KEY=          # 公司成立後填入：HashKey
# ECPAY_HASH_IV=           # 公司成立後填入：HashIV
# ECPAY_AIO_URL=https://payment.ecpay.com.tw/Cashier/AioCheckOut/V5   # 公司成立後填入（正式收銀台）
ECPAY_ACCEPT_SIMULATED=0   # STAGE 測試時可設 1；production 若為 1 會拒絕啟動
ECPAY_NOTIFY_IP_ALLOWLIST= # 綠界通知來源 IP（逗號分隔，可 CIDR；向綠界索取最新清單）；空＝不限制
ECPAY_NOTIFY_MAX_AGE_HOURS=0 # 通知 PaymentDate 超過幾小時即拒絕（0＝不檢查；正式建議 72）

# ── 簡訊（三竹 Mitake；公司成立後申請）──────────────────────
# 空白＝簡訊停用：OTP 登入回 503 SMS_DISABLED（明確標示測試模式），簡訊通知進入重試後標記失敗。
MITAKE_API_URL=https://smsapi.mitake.com.tw/api/mtk/SmSend
MITAKE_USERNAME=           # 公司成立後填入
MITAKE_PASSWORD=           # 公司成立後填入（secret）

# ── 工作階段與金鑰 ───────────────────────────────────────
# 會員/後台 session 為資料庫內的隨機 token（不需簽章金鑰）；cookie 於 production 自動加上 Secure。
SESSION_TTL_DAYS=30
# ★ TOTP 兩步驟驗證金鑰的加密金鑰：32 bytes（hex 64 字或 base64）；production 必填，設定後不可更換（否則已綁定的 TOTP 失效）
#   產生：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MFA_ENCRYPTION_KEY=

# ── 後台帳號 ─────────────────────────────────────────────
# 正式環境：npm run admin:create -- --login <帳號>（或容器內 node dist/create-admin.mjs）建立第一個超級管理員。
# NEW_ADMIN_PASSWORD=      # 只在非互動執行 create-admin 時使用；用完即刪除
# 開發種子（npm run db:seed）以此設定示範後台帳號（admin / ops / finance-a / finance-b / support）的初始密碼；只存 scrypt 雜湊。
ADMIN_INITIAL_PASSWORD=
ADMIN_PASSWORD_HINT=           # 選用：後台登入頁的密碼提示（提示會降低安全性）
ADMIN_REAUTH_MAX_AGE_MIN=30    # 後台操作需在此分鐘數內重新驗證過密碼
ADMIN_MFA_REQUIRED=false       # ★ 第一個管理員綁定 TOTP 後改為 true：後台必須啟用兩步驟驗證
ADMIN_IP_ALLOWLIST=            # 後台 IP 允許清單（逗號分隔，可 CIDR）；空＝不限制
CS_COMPENSATION_APPROVAL_THRESHOLD=500 # 客服補償點數超過此數需第二人核准

# ── 通知（站內＋外部管道）────────────────────────────────
NOTIFY_STUB_SEND=0             # 1：外部管道假裝送出成功（僅開發；production 必須為 0）
NOTIFY_MAX_ATTEMPTS=6
NOTIFY_BACKOFF_BASE_SEC=30
LINE_CHANNEL_ACCESS_TOKEN=     # LINE Messaging API（選用）
VAPID_PUBLIC_KEY=              # Web Push（選用）
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:service@chiaki.example

# ── Email ────────────────────────────────────────────────
EMAIL_FROM="CHIAKI <no-reply@chiaki.example>"   # ★ 改為公司網域信箱
# 預留（Email 外送尚未串接，程式目前不讀取）：選定寄信服務（Resend / SES / SMTP）後再補
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=

# ── 背景工作（worker：通知外送、寄存到期、VIP 每月優惠券/生日禮/年度評等…）──
WORKER_TICK_SEC=30             # 檢查排程的間隔
WORKER_NOTIFY_INTERVAL_SEC=60  # 通知外送間隔
WORKER_RETRY_SEC=300           # 工作失敗後多久重試

# ── 抽賞 ─────────────────────────────────────────────────
HOLD_SECONDS=180               # 鎖籤保留秒數（待產品確認）
MAX_TICKETS_PER_DRAW=100
MAX_TICKETS_PER_HOLD=100
AGE_MIN=18                     # 年齡門檻（業主確認 18）
ALLOW_TICKET_PICK=             # 舊的自選籤號（鎖籤＋指定籤號抽）；預設關閉，網站只提供快速抽（drawPacks）
FREE_PLAY_PER_MIN=30           # 免費試玩 /api/play/:poolId 每 IP 每分鐘上限（不需登入、不動庫存與帳務）

# ── 寄存 ─────────────────────────────────────────────────
STORAGE_FREE_DAYS=30           # 自入庫起免費寄存天數
STORAGE_WARN_DAYS_BEFORE=7     # 到期前幾天通知（另有到期當日通知）

# ── 風控 ─────────────────────────────────────────────────
RISK_HOLD_LIMIT_PER_MIN=30
RISK_DRAW_LIMIT_PER_MIN=20
RISK_DEVICE_ACCOUNT_THRESHOLD=3
RISK_LARGE_TOPUP_TWD=20000

# ── 邀請獎勵 ─────────────────────────────────────────────
REFERRAL_REWARD_THRESHOLD=20   # 完成註冊＋手機驗證的被邀請人數
REFERRAL_REWARD_COINS=1000     # 獎勵代幣（不可退款，每人一次）
REFERRAL_PHONE_PREFIX_LEN=8    # 防濫用：手機前 N 碼相同視為連號
REFERRAL_PHONE_PREFIX_MAX=3    # 同一邀請人底下同前綴達此數 → 之後的標記不計入
REFERRAL_IP_BURST_MAX=3        # 同一 IP 在時間窗內註冊達此數 → 之後的標記不計入
REFERRAL_IP_BURST_WINDOW_MIN=60

# ── 應用層防火牆（邊緣 WAF 規則見 docs/security.md）────────
RATE_LIMIT_IP_CAPACITY=120     # 每 IP token bucket 容量
RATE_LIMIT_IP_REFILL_PER_SEC=2
RATE_LIMIT_USER_CAPACITY=60    # 每會員 token bucket 容量
RATE_LIMIT_USER_REFILL_PER_SEC=1
PHONE_CHANGE_OTP_PER_HOUR=5    # 換手機 OTP（送到新號碼）每位會員每小時上限
FORUM_POSTS_PER_DAY=5          # 討論區：每位會員每日發文上限
FORUM_COMMENTS_PER_DAY=30      # 討論區：每位會員每日留言上限
FORUM_REPORTS_PER_DAY=20       # 討論區：每位會員每日檢舉上限
MAX_BODY_BYTES=65536           # 請求本文上限
BLOCKLIST_CACHE_MS=30000       # 封鎖清單快取毫秒數
BOT_MAX_REQUESTS=10            # 抽賞/鎖籤：BOT_WINDOW_MS 內超過此次數視為機器人
BOT_WINDOW_MS=3000
LOGIN_BACKOFF_AFTER=3          # 連續失敗幾次起指數退避
LOGIN_BACKOFF_BASE_SEC=2
LOGIN_MAX_FAILURES=10          # 達此次數鎖定 LOGIN_LOCK_MINUTES 分鐘
LOGIN_LOCK_MINUTES=30

# ── 開發替身（★ production 必須為 0，否則拒絕啟動）────────
AUTH_DEV_STUB=1                # OTP 固定碼 000000
REWARD_VERIFY_STUB=1           # LINE/IG 任務視為已完成

# ── 測試（npm test 會自動啟動暫時的 PostgreSQL；如已有伺服器可指定）──
# TEST_DATABASE_ADMIN_URL=postgres://postgres@127.0.0.1:5432/postgres
# PG_BIN=/usr/lib/postgresql/16/bin
# PG_RUN_AS=claude             # 以 root 執行時，postgres 需以一般使用者身分啟動
# PGLOCAL_DIR= / PGLOCAL_PORT= # npm run db:local 的資料目錄與埠（預設 /tmp/chiaki-pg / 55432）
