// CHIAKI Prisma schema（鏡像）
//
// ⚠ 資料庫結構的「唯一真實來源」是 prisma/migrations/*/migration.sql（含 CHECK、trigger、部分索引等
//   Prisma schema 無法表達的防護）。本檔由實際 migrate 後的資料庫結構產生，並由 tests/schema-drift.test.ts
//   在每次測試時比對資料表/欄位/型別/可空性，確保兩者一致。
// ⚠ 本開發環境無法連線 npm registry 與 binaries.prisma.sh，因此尚未以 `prisma validate`/`prisma generate`
//   驗證；執行期資料存取使用 postgres.js（原生 SQL、明確交易與 FOR UPDATE 列鎖）。
//   若日後改用 Prisma Client：`npx prisma validate && npx prisma generate`，並以
//   `npx prisma migrate resolve --applied 20261023000000_init` 與
//   `npx prisma migrate resolve --applied 20261024000000_grades_storage_prepaid_shipping` 與
//   `npx prisma migrate resolve --applied 20261025000000_owner_rules_ops_security` 與
//   `npx prisma migrate resolve --applied 20261026000000_image_assets` 與
//   `npx prisma migrate resolve --applied 20261027000000_item_refunds_categories_ip_catalog` 與
//   `npx prisma migrate resolve --applied 20261028000000_ip_categories_five` 標記既有 migration。
// 檢視 member_draw_history（會員可見的近 90 天抽賞紀錄）未列於此（Prisma 視圖需 previewFeatures = ["views"]）。
// 關聯欄位（relation fields）刻意省略：外鍵已在 SQL migration 中定義。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AccessBlocklist {
  id        BigInt    @id @default(autoincrement())
  kind      String
  value     String
  reason    String    @default("")
  expiresAt DateTime? @map("expires_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  @@unique([kind, value])
  @@map("access_blocklist")
}

model AdminCredential {
  userId              String    @id @map("user_id") @db.Uuid
  loginId             String    @unique @map("login_id")
  passwordHash        String    @map("password_hash")
  passwordHint        String?   @map("password_hint")
  mfaSecretEnc        String?   @map("mfa_secret_enc")
  mfaPendingSecretEnc String?   @map("mfa_pending_secret_enc")
  mfaEnabledAt        DateTime? @map("mfa_enabled_at") @db.Timestamptz(6)
  mfaLastStep         BigInt?   @map("mfa_last_step")
  passwordChangedAt   DateTime  @default(now()) @map("password_changed_at") @db.Timestamptz(6)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  @@map("admin_credentials")
}

model AppSetting {
  key       String   @id
  value     String
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  @@map("app_settings")
}

model ApprovalRequest {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  merchantId   String    @default("chiaki") @map("merchant_id")
  type         String
  targetId     String    @map("target_id")
  payloadJson  String    @map("payload_json")
  status       String    @default("PENDING")
  requestedBy  String    @map("requested_by") @db.Uuid
  decidedBy    String?   @map("decided_by") @db.Uuid
  decidedAt    DateTime? @map("decided_at") @db.Timestamptz(6)
  decisionNote String?   @map("decision_note")
  resultJson   String?   @map("result_json")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  @@map("approval_requests")
}

model Asset {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  merchantId         String   @default("chiaki") @map("merchant_id")
  type               String
  format             String
  width              Int
  height             Int
  bytes              Int
  sha256             String
  altText            String   @map("alt_text")
  copyrightConfirmed Boolean  @map("copyright_confirmed")
  originalFilename   String?  @map("original_filename")
  uploadedBy         String   @map("uploaded_by") @db.Uuid
  content            Bytes
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  @@unique([type, sha256])
  @@map("assets")
}

model AssetLink {
  assetId    String   @map("asset_id") @db.Uuid
  targetType String   @map("target_type")
  targetId   String   @map("target_id")
  role       String   @default("main")
  createdBy  String   @map("created_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  @@id([assetId, targetType, targetId, role])
  @@map("asset_links")
}

model AuditHead {
  id       Int    @id
  lastSeq  BigInt @map("last_seq")
  lastHash String @map("last_hash")
  @@map("audit_head")
}

model AuditLog {
  seq         BigInt  @id
  merchantId  String  @default("chiaki") @map("merchant_id")
  actorType   String  @map("actor_type")
  actorId     String? @map("actor_id")
  action      String
  entityType  String  @map("entity_type")
  entityId    String  @map("entity_id")
  payloadJson String  @map("payload_json")
  createdAt   String  @map("created_at")
  prevHash    String  @map("prev_hash")
  hash        String  @unique
  @@map("audit_log")
}

model AuthLockout {
  key           String    @id
  failures      Int       @default(0)
  lockedUntil   DateTime? @map("locked_until") @db.Timestamptz(6)
  lastFailureAt DateTime? @map("last_failure_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  @@map("auth_lockouts")
}

model AuthSession {
  tokenHash String    @id @map("token_hash")
  userId    String    @map("user_id") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  authMethod String @default("OTP") @map("auth_method")
  reauthAt DateTime? @map("reauth_at") @db.Timestamptz(6)
  mfaVerifiedAt DateTime? @map("mfa_verified_at") @db.Timestamptz(6)
  @@map("auth_sessions")
}

model Carrier {
  code                String  @id
  label               String
  category            String
  trackingUrlTemplate String  @map("tracking_url_template")
  active              Boolean @default(true)
  sortOrder           Int     @default(0) @map("sort_order")
  @@map("carriers")
}

model CsAction {
  id                BigInt   @id @default(autoincrement())
  ticketId          String   @map("ticket_id") @db.Uuid
  action            String
  paramsJson        String   @map("params_json")
  resultJson        String   @map("result_json")
  actorId           String   @map("actor_id") @db.Uuid
  approvalRequestId String?  @map("approval_request_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  @@map("cs_actions")
}

model CsCannedReply {
  code      String  @id
  category  String?
  title     String
  body      String
  active    Boolean @default(true)
  sortOrder Int     @default(0) @map("sort_order")
  @@map("cs_canned_replies")
}

model CsCategory {
  code      String @id
  label     String
  slaHours  Int    @map("sla_hours")
  sortOrder Int    @default(0) @map("sort_order")
  @@map("cs_categories")
}

model CsMessage {
  id         BigInt   @id @default(autoincrement())
  ticketId   String   @map("ticket_id") @db.Uuid
  authorType String   @map("author_type")
  authorId   String?  @map("author_id") @db.Uuid
  body       String
  internal   Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  @@map("cs_messages")
}

model CsTicket {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  merchantId           String    @default("chiaki") @map("merchant_id")
  ticketNo             BigInt    @default(autoincrement()) @unique @map("ticket_no")
  userId               String    @map("user_id") @db.Uuid
  category             String
  subject              String
  status               String    @default("OPEN")
  assigneeId           String?   @map("assignee_id") @db.Uuid
  slaDueAt             DateTime  @map("sla_due_at") @db.Timestamptz(6)
  linkedDrawId         String?   @map("linked_draw_id") @db.Uuid
  linkedPaymentOrderId String?   @map("linked_payment_order_id") @db.Uuid
  linkedShipmentId     String?   @map("linked_shipment_id") @db.Uuid
  firstResponseAt      DateTime? @map("first_response_at") @db.Timestamptz(6)
  closedAt             DateTime? @map("closed_at") @db.Timestamptz(6)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  @@map("cs_tickets")
}

model Draw {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  merchantId     String   @default("chiaki") @map("merchant_id")
  userId         String   @map("user_id") @db.Uuid
  poolId         String   @map("pool_id") @db.Uuid
  setId          String   @map("set_id") @db.Uuid
  ruleVersionId  String   @map("rule_version_id") @db.Uuid
  idempotencyKey String   @map("idempotency_key")
  ticketCount    Int      @map("ticket_count")
  unitPrice      BigInt   @map("unit_price")
  amountCoins    BigInt   @map("amount_coins")
  shippingCoins  BigInt   @default(0) @map("shipping_coins")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  @@unique([userId, idempotencyKey])
  @@map("draws")
}

model DrawArchive {
  drawId        String   @id @map("draw_id") @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  batchId       String   @map("batch_id") @db.Uuid
  drawCreatedAt DateTime @map("draw_created_at") @db.Timestamptz(6)
  archivedAt    DateTime @default(now()) @map("archived_at") @db.Timestamptz(6)
  @@map("draw_archive")
}

model DrawResult {
  id              BigInt  @id @default(autoincrement())
  drawId          String  @map("draw_id") @db.Uuid
  seq             Int
  kind            String
  ticketNo        Int?    @map("ticket_no")
  prizeId         String? @map("prize_id") @db.Uuid
  rank            String?
  tier            Int?
  grade           String?
  prizeName       String  @map("prize_name")
  warehouseItemId String  @map("warehouse_item_id") @db.Uuid
  levelNo         Int?    @map("level_no")
  levelName       String? @map("level_name")
  isSmall         Boolean @default(false) @map("is_small")
  @@unique([drawId, seq])
  @@map("draw_results")
}

model GuaranteeCounter {
  userId    String   @map("user_id") @db.Uuid
  poolId    String   @map("pool_id") @db.Uuid
  misses    Int      @default(0)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@id([userId, poolId])
  @@map("guarantee_counters")
}

model IdempotencyKey {
  userId       String   @map("user_id") @db.Uuid
  scope        String
  key          String
  requestHash  String   @map("request_hash")
  responseJson String?  @map("response_json")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([userId, scope, key])
  @@map("idempotency_keys")
}

model Ip {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  merchantId String   @default("chiaki") @map("merchant_id")
  slug       String   @unique
  name       String
  sortOrder  Int      @default(0) @map("sort_order")
  visible    Boolean  @default(true)
  coverUrl   String?  @map("cover_url")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  aliases String[] @default([])
  @@unique([merchantId, name])
  @@map("ips")
}

model Merchant {
  id        String   @id
  name      String
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  @@map("merchants")
}

model Notification {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  merchantId  String    @default("chiaki") @map("merchant_id")
  userId      String    @map("user_id") @db.Uuid
  type        String
  channel     String    @default("IN_APP")
  title       String
  body        String
  payloadJson String    @default("{}") @map("payload_json")
  dedupeKey   String    @unique @map("dedupe_key")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  readAt      DateTime? @map("read_at") @db.Timestamptz(6)
  @@map("notifications")
}

model NotificationOutbox {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  merchantId     String    @default("chiaki") @map("merchant_id")
  userId         String    @map("user_id") @db.Uuid
  eventType      String    @map("event_type")
  channel        String
  idempotencyKey String    @unique @map("idempotency_key")
  destination    String?
  title          String
  body           String
  payloadJson    String    @default("{}") @map("payload_json")
  status         String    @default("PENDING")
  attempts       Int       @default(0)
  nextAttemptAt  DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  lockedUntil    DateTime? @map("locked_until") @db.Timestamptz(6)
  lastError      String?   @map("last_error")
  providerRef    String?   @map("provider_ref")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  sentAt         DateTime? @map("sent_at") @db.Timestamptz(6)
  @@map("notification_outbox")
}

model NotificationPreference {
  userId    String   @map("user_id") @db.Uuid
  channel   String
  eventType String   @map("event_type")
  enabled   Boolean
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  @@id([userId, channel, eventType])
  @@map("notification_preferences")
}

model PaymentNotification {
  id              BigInt   @id @default(autoincrement())
  provider        String
  merchantTradeNo String?  @map("merchant_trade_no")
  rawBody         String   @map("raw_body")
  macValid        Boolean  @map("mac_valid")
  outcome         String
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  @@map("payment_notifications")
}

model PaymentOrder {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  merchantId      String    @default("chiaki") @map("merchant_id")
  userId          String    @map("user_id") @db.Uuid
  provider        String
  merchantTradeNo String    @unique @map("merchant_trade_no")
  packageCode     String    @map("package_code")
  amountTwd       BigInt    @map("amount_twd")
  coins           BigInt
  bonusPoints     BigInt    @default(0) @map("bonus_points")
  status          String    @default("PENDING")
  providerTradeNo String?   @map("provider_trade_no")
  paymentType     String?   @map("payment_type")
  bankLast5       String?   @map("bank_last5")
  paidAt          DateTime? @map("paid_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  @@map("payment_orders")
}

model Pool {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  merchantId           String    @default("chiaki") @map("merchant_id")
  slug                 String    @unique
  title                String
  ip                   String    @default("")
  description          String    @default("")
  terms                String    @default("")
  source               String
  playType             String    @map("play_type")
  priceCoins           BigInt    @map("price_coins")
  setCount             Int       @map("set_count")
  lastPrizeName        String?   @map("last_prize_name")
  status               String    @default("DRAFT")
  currentRuleVersionId String?   @map("current_rule_version_id") @db.Uuid
  createdBy            String?   @map("created_by") @db.Uuid
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  publishedAt          DateTime? @map("published_at") @db.Timestamptz(6)
  shippingNote         String    @default("") @map("shipping_note")
  shipFeeHome          BigInt    @default(150) @map("ship_fee_home")
  shipFeeCvs           BigInt    @default(70) @map("ship_fee_cvs")
  ipId String? @map("ip_id") @db.Uuid
  drawPacks String[] @default(["1", "5", "10"]) @map("draw_packs")
  offline      Boolean   @default(false)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)
  deleteReason String?   @map("delete_reason")
  @@map("pools")
}

model PoolGuarantee {
  poolId           String  @id @map("pool_id") @db.Uuid
  everyN           Int     @map("every_n")
  minLevel         Int     @map("min_level")
  reserveRank      String? @map("reserve_rank")
  reservePrizeName String  @map("reserve_prize_name")
  reserveTotal     Int     @map("reserve_total")
  reserveUsed      Int     @default(0) @map("reserve_used")
  reservePrizeId   String  @map("reserve_prize_id") @db.Uuid
  @@map("pool_guarantees")
}

model PoolPrize {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  poolId       String  @map("pool_id") @db.Uuid
  rank         String?
  name         String
  qtyPerSet    Int     @map("qty_per_set")
  sortOrder    Int     @default(0) @map("sort_order")
  kind         String  @default("TICKET")
  grade        String?
  recycleValue BigInt  @default(0) @map("recycle_value")
  recyclable   Boolean @default(false)
  bulky Boolean @default(false)
  levelId  String? @map("level_id") @db.Uuid
  imageUrl String? @map("image_url")
  tag      String?
  @@map("pool_prizes")
}

/// 0 銷售時重新產生籤表而被取代的承諾（append-only；舊 salt 與籤表可公開驗證）
model PoolSetCommitHistory {
  id           BigInt   @id @default(autoincrement())
  poolId       String   @map("pool_id") @db.Uuid
  setId        String   @map("set_id") @db.Uuid
  setNo        Int      @map("set_no")
  commitScheme String   @map("commit_scheme")
  commitment   String
  commitSalt   String   @map("commit_salt")
  rulesHash    String   @map("rules_hash")
  layoutJson   String   @map("layout_json")
  reason       String
  supersededBy String?  @map("superseded_by") @db.Uuid
  supersededAt DateTime @default(now()) @map("superseded_at") @db.Timestamptz(6)
  @@map("pool_set_commit_history")
}

/// 獎項等級 1–8（等級 1 最高）；is_small：計入「滿 20 件運費」與逐件運費退還
model PoolLevel {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  poolId    String   @map("pool_id") @db.Uuid
  levelNo   Int      @map("level_no")
  name      String
  isSmall   Boolean  @map("is_small")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  @@unique([poolId, levelNo])
  @@map("pool_levels")
}

model PoolRuleVersion {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  merchantId  String    @default("chiaki") @map("merchant_id")
  poolId      String    @map("pool_id") @db.Uuid
  version     Int
  rulesJson   String    @map("rules_json")
  rulesHash   String    @map("rules_hash")
  createdBy   String?   @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)
  @@unique([poolId, version])
  @@map("pool_rule_versions")
}

model PoolSet {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  merchantId      String    @default("chiaki") @map("merchant_id")
  poolId          String    @map("pool_id") @db.Uuid
  setNo           Int       @map("set_no")
  ruleVersionId   String    @map("rule_version_id") @db.Uuid
  status          String
  totalTickets    Int       @map("total_tickets")
  commitScheme    String    @map("commit_scheme")
  commitment      String
  commitSalt      String    @map("commit_salt")
  lastPrizeUserId String?   @map("last_prize_user_id") @db.Uuid
  publishedAt     DateTime  @default(now()) @map("published_at") @db.Timestamptz(6)
  onSaleAt        DateTime? @map("on_sale_at") @db.Timestamptz(6)
  soldOutAt       DateTime? @map("sold_out_at") @db.Timestamptz(6)
  shipFeeHome     BigInt    @default(150) @map("ship_fee_home")
  shipFeeCvs      BigInt    @default(70) @map("ship_fee_cvs")
  shipRefundDiv Int @default(20) @map("ship_refund_div")
  offline      Boolean   @default(false)
  displayName  String?   @map("display_name")
  internalNote String    @default("") @map("internal_note")
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)
  deleteReason String?   @map("delete_reason")
  @@unique([poolId, setNo])
  @@map("pool_sets")
}

model Product {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  merchantId String   @default("chiaki") @map("merchant_id")
  sku        String   @unique
  name       String
  ip         String   @default("")
  source     String
  priceCoins BigInt   @map("price_coins")
  stock      Int
  status     String   @default("ACTIVE")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  bulky Boolean @default(false)
  tag   String?
  @@map("products")
}

model PurchaseOrder {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  merchantId     String   @default("chiaki") @map("merchant_id")
  userId         String   @map("user_id") @db.Uuid
  productId      String   @map("product_id") @db.Uuid
  qty            Int
  unitPrice      BigInt   @map("unit_price")
  amountCoins    BigInt   @map("amount_coins")
  idempotencyKey String   @map("idempotency_key")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  @@unique([userId, idempotencyKey])
  @@map("purchase_orders")
}

model PushSubscription {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  endpoint  String    @unique
  p256dh    String
